<?xml version="1.0"?>

<launch>
    <include file="$(find mavros)/launch/px4.launch">
       <arg name="fcu_url" value="/dev/ttyACM0:921600"/>
    </include>

    <node pkg="fsm_ctrl" type="single_offboard_fsm" name="single_offboard_fsm" output="screen">
        <param name = "real_environment" type = "bool" value = "true" />
        <rosparam file="$(find fsm_ctrl)/config/controller_params.yaml" command="load" />
    </node>
</launch>
